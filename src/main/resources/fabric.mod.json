{
  "schemaVersion": 1,
  "name": "Notebot",
  "id": "notebot",
  "version": "${version}",
  "description": "A standalone noteblock bot for Fabric. Play songs using note blocks in Minecraft.",
  "authors": [
    "Notebot"
  ],
  "contact": {
    "homepage": "https://github.com/notebot/notebot",
    "sources": "https://github.com/notebot/notebot"
  },
  "license": "GPL-3.0",
  "icon": "assets/notebot/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.notebot.NotebotMod"
    ]
  },
  "mixins": [
    "notebot.mixins.json"
  ],
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${loader_version}"
  }
}